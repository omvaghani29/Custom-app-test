{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install && npm run setup",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/server.js": {
      "memory": 1024,
      "maxDuration": 60,
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server"
    }
  ]
}
